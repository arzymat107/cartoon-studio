{
  "name": "cartoon-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Make cartoons with HTML, CSS and TypeScript: reusable SVG components animated with GSAP timelines.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "voices": "node scripts/generate-voices.mjs",
    "sounds": "node scripts/fetch-sounds.mjs",
    "export": "node scripts/export-video.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
